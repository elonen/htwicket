# Builder image for producing htwicket .deb packages with cargo-deb.
# `make debian-docker` builds this once per Debian release (DEBIAN_VER) and
# architecture (via --platform), then runs `make debian-local` inside it as
# root. htwicket is pure Rust with no native library deps, so rust:slim's
# bundled gcc/libc toolchain is all that's needed to compile and link.
ARG DEBIAN_VER=trixie
FROM rust:1-slim-${DEBIAN_VER} AS builder

# `make` runs the in-container build; `dpkg-dev` provides dpkg-shlibdeps, which
# cargo-deb's `$auto` Depends resolution needs (without it the .deb gets no
# shared-library dependencies). gcc/libc for linking are already in rust:slim.
RUN apt-get -qy update \
 && apt-get -qy install --no-install-recommends make dpkg-dev \
 && rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-deb

WORKDIR /app
COPY . /app

CMD ["make", "debian-local"]
