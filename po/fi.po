#: templates/admin.html:2 templates/admin.html:7
msgid "User management"
msgstr "Käyttäjätilien hallinta"

#: templates/admin.html:8
msgid "Rename, set a password, or edit profile fields, then save."
msgstr "Nimeä uudelleen, aseta salasana tai muokkaa profiilikenttiä. Lopuksi tallenna."

#: templates/admin.html:10
msgid "users"
msgstr "käyttäjät"

#: templates/admin.html:25
msgid "No users yet"
msgstr "Ei vielä käyttäjiä"

#: templates/admin.html:26
msgid "Add the first account below."
msgstr "Lisää ensimmäinen tili alla."

#: templates/admin.html:35 templates/admin.html:79 templates/login.html:16
msgid "Username"
msgstr "Käyttäjätunnus"

#: templates/admin.html:35
msgid "no password"
msgstr "ei salasanaa"

#: templates/admin.html:39
msgid "Set new password"
msgstr "Aseta uusi salasana"

#: templates/admin.html:43
msgid "Delete"
msgstr "Poista"

#: templates/admin.html:50
